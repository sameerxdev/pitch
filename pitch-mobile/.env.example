# Copy this file to .env and fill in your values
# Development — use your PC's LAN IP when testing on a physical device (same Wi‑Fi as Metro).
# Do not use 0.0.0.0 here; that only works in Swagger/curl on the host machine.
# Use the same LAN IP as Expo Metro (exp://192.168.x.x:8081 → http://192.168.x.x:8000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://192.168.100.200:8000/api/v1

# Staging
# EXPO_PUBLIC_API_BASE_URL=https://staging-api.pitchpk.com/api/v1

# Production
# EXPO_PUBLIC_API_BASE_URL=https://api.pitchpk.com/api/v1
