# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=pitch

# --- JWT ---
JWT_SECRET=change_me_super_secret_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Development helper: when true, OTP is returned in response and a debug log entry is printed
OTP_DEBUG=true
# Skip OTP entirely: /auth/verify-otp accepts any code. DISABLE IN PRODUCTION.
AUTH_BYPASS_OTP=true
# Auto-settle payment on /payments/initiate so the mobile pay-screen poll succeeds
# without a real JazzCash/Easypaisa gateway. DISABLE IN PRODUCTION.
PAYMENT_AUTO_COMPLETE=true

# --- Business rules ---
HOLD_DURATION_SECONDS=600
PLAYER_MAX_BOOKING_DAYS_AHEAD=14
QR_SCAN_WINDOW_MINUTES=30
MAX_GROUND_PHOTOS=8
MAX_REVIEW_PHOTOS=3

# --- File uploads ---
UPLOAD_DIR=/data/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
